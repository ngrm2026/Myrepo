# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.

# Public website address (used for SEO, sitemap and social sharing), without trailing slash
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- Enquiry form delivery (set up at least one) ---
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=you@your-domain.com
# Must be an address on a domain verified in Resend (until then you can use onboarding@resend.dev for testing)
ENQUIRY_FROM_EMAIL="Website Enquiry <enquiry@your-domain.com>"

# Option B: webhook — e.g. Google Sheets (see docs/ENQUIRIES.md), Zapier or Make
ENQUIRY_WEBHOOK_URL=

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
