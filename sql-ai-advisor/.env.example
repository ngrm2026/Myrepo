# Copy this file to .env and fill it in.  .env is git-ignored — never commit keys.

# ---- SQL Server (read-only access is enough) ----
SQL_SERVER=localhost\MYSQLSERVER2022
# e.g. localhost\SQLEXPRESS  or  (localdb)\MSSQLLocalDB
SQL_DATABASE=AdvisorDemo
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=true
SQL_USER=
SQL_PASSWORD=
SQL_TRUST_SERVER_CERTIFICATE=true

# ---- LLM: azure | openai | anthropic | ollama (free, runs locally) ----
LLM_PROVIDER=azure
# Azure: your deployment name. OpenAI: e.g. gpt-4o-mini. Anthropic: e.g. claude-sonnet-5-5
LLM_MODEL=

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama: install from ollama.com, then: ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Behaviour ----
LOOKBACK_HOURS=24
TOP_N=10
MAX_PLAN_CHARS=30000
# Replace string literals and sniffed parameter values before sending to the LLM
MASK_LITERALS=true
